APP_NAME="Bendito Orgânico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# Sem DB_DATABASE o Laravel usa database/database.sqlite com caminho absoluto,
# que continua correto mesmo quando o processo roda de outro diretório
# (worker de fila, agendador, etc.).
# DB_DATABASE=

# Para usar MySQL, comente o bloco acima e descomente este:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bendito_organico
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessão, cache e filas
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# E-mail (recuperação de senha e avisos de pedido)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@benditoorganico.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Mercado Pago
# ---------------------------------------------------------------------------
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais de TESTE durante o desenvolvimento.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Painel > Webhooks > Configurar notificações > "Assinatura secreta"
MERCADOPAGO_WEBHOOK_SECRET=

# Deixe true em produção. Só desative para depurar localmente.
MERCADOPAGO_VERIFY_SIGNATURE=true
MERCADOPAGO_STATEMENT_DESCRIPTOR=BENDITOORGANICO
MERCADOPAGO_EXPIRES_AFTER_MINUTES=60
MERCADOPAGO_INSTALLMENTS=12
# Meios bloqueados no checkout (payment_type_id, separados por vírgula).
# A loja aceita SÓ Pix e cartão de crédito, e a lista do Checkout Pro é por
# exclusão — por isso débito, pré-pago e saldo Mercado Pago também saem.
# Continuam liberados: bank_transfer (Pix) e credit_card.
MERCADOPAGO_EXCLUDED_PAYMENT_TYPES=ticket,atm,debit_card,prepaid_card,account_money
# Detectado automaticamente pelo prefixo TEST- do access token; force se precisar.
MERCADOPAGO_SANDBOX=

# URL pública usada pelo webhook do Mercado Pago. Em desenvolvimento use um
# túnel (ngrok, expose, cloudflared) — o Mercado Pago não alcança localhost.
# Ex.: MERCADOPAGO_WEBHOOK_URL=https://seu-tunel.ngrok-free.app/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Loja
# ---------------------------------------------------------------------------
# Pedido mínimo em reais, comparado contra o subtotal (produto x quantidade).
# A entrega é combinada depois e não conta para alcançar o mínimo.
# Zero desliga a regra.
CHECKOUT_MINIMUM_ORDER=50

STORE_NAME="Bendito Orgânico"
STORE_EMAIL=contato@benditoorganico.com.br
STORE_PHONE="(11) 99999-0000"
STORE_WHATSAPP=5511999990000
STORE_CITY="São Paulo"
STORE_STATE=SP

# ---------------------------------------------------------------------------
# Créditos
# ---------------------------------------------------------------------------
DEVELOPER_NAME="Origin Hub"
DEVELOPER_URL=https://originhub.com.br

VITE_APP_NAME="${APP_NAME}"
