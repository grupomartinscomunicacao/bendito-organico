# ===========================================================================
# Bendito Orgânico — modelo do .env de PRODUÇÃO
#
# Copie para /var/www/benditoorganico.com.br/.env no servidor e ajuste o que
# está marcado com "PREENCHER". Este arquivo é versionado de propósito e por
# isso NÃO contém segredo nenhum — o .env real nunca entra no git.
#
#   cp deploy/env.production.example .env
#   php artisan key:generate      # gera o APP_KEY desta instalação
#   chmod 640 .env                # ninguém além do dono e do grupo lê
# ===========================================================================

APP_NAME="Bendito Orgânico"
APP_ENV=production

# Gerado no servidor com "php artisan key:generate".
# Deliberadamente diferente da chave de desenvolvimento. Nenhuma coluna do
# banco é criptografada, então trocar a chave não perde dado — só invalida
# as sessões abertas (o admin refaz o login uma vez).
APP_KEY=

# NUNCA true em produção: um stack trace numa página de erro entrega caminho
# de arquivo, versão de pacote e trecho de configuração para qualquer visitante.
APP_DEBUG=false

APP_URL=https://benditoorganico.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Banco de dados — o MESMO SQLite do ambiente local
# ---------------------------------------------------------------------------
# O arquivo é copiado por scp para database/database.sqlite (ele é ignorado
# pelo git, justamente por conter dado de cliente).
#
# Sem DB_DATABASE o Laravel resolve database_path('database.sqlite') em
# caminho absoluto, o que mantém o worker de fila e o agendador apontando
# para o banco certo mesmo rodando de outro diretório.
DB_CONNECTION=sqlite

# WAL, busy_timeout e transação IMMEDIATE já vêm de config/database.php —
# é o que deixa o webhook do Mercado Pago escrever enquanto a loja lê.

# ---------------------------------------------------------------------------
# Sessão, cache e filas
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Só faz sentido com HTTPS ativo — impede o cookie de sessão de trafegar
# em claro se alguém acessar por http.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
# "daily" em vez de "single": o arquivo não cresce sem fim e o disco da VPS
# não enche por causa de log. LOG_LEVEL=warning corta o ruído de debug.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# E-mail — mantido em "log" por enquanto
# ---------------------------------------------------------------------------
# ATENÇÃO: com MAIL_MAILER=log nada é enviado de verdade. A recuperação de
# senha do painel e o aviso de pedido pago só aparecem em
# storage/logs/laravel-*.log. Para ativar de fato, troque para "smtp" e
# preencha o bloco abaixo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@benditoorganico.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Quando for ligar o SMTP (ex.: Titan/Hostinger):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=nao-responda@benditoorganico.com.br
# MAIL_PASSWORD=PREENCHER

# ---------------------------------------------------------------------------
# Mercado Pago — Checkout Pro, credenciais de PRODUÇÃO
# ---------------------------------------------------------------------------
# Copie os três valores do .env local (eles são segredo e não entram no git).
# Credenciais: https://www.mercadopago.com.br/developers/panel/app
#
# O token de produção começa com "APP_USR-". Um que comece com "TEST-" liga o
# modo sandbox sozinho e o checkout passa a usar o sandbox_init_point.
MERCADOPAGO_ACCESS_TOKEN=PREENCHER
MERCADOPAGO_PUBLIC_KEY=PREENCHER

# Painel > Webhooks > Configurar notificações > "Assinatura secreta".
# Cadastre esta URL lá, com os eventos de "Pagamentos":
#   https://benditoorganico.com.br/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=PREENCHER

# Mantenha true: é a assinatura HMAC que prova que a notificação veio mesmo
# do gateway, e não de alguém chutando a URL do webhook. Sem o secret acima
# preenchido, com isto em true, TODA notificação é recusada — e o pedido
# nunca é marcado como pago.
MERCADOPAGO_VERIFY_SIGNATURE=true

MERCADOPAGO_STATEMENT_DESCRIPTOR=BENDITOORGANICO
MERCADOPAGO_EXPIRES_AFTER_MINUTES=60
MERCADOPAGO_INSTALLMENTS=12

# A loja aceita SÓ Pix e cartão de crédito. A lista do Checkout Pro é por
# exclusão, então débito, pré-pago e saldo Mercado Pago saem junto com boleto
# e caixa eletrônico. Sobram liberados bank_transfer (Pix) e credit_card.
MERCADOPAGO_EXCLUDED_PAYMENT_TYPES=ticket,atm,debit_card,prepaid_card,account_money

# Vazio = detecta pelo prefixo do token (TEST- vira sandbox).
MERCADOPAGO_SANDBOX=

# Vazio = derivado do APP_URL, que já é o domínio definitivo.
MERCADOPAGO_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Loja — REVISAR: telefone e endereço abaixo ainda são de exemplo
# ---------------------------------------------------------------------------
# Pedido mínimo em reais, comparado contra o subtotal (produto x quantidade).
# A entrega é combinada depois e não conta para alcançar o mínimo.
CHECKOUT_MINIMUM_ORDER=50

STORE_NAME="Bendito Orgânico"
STORE_EMAIL=contato@benditoorganico.com.br
STORE_PHONE="(11) 99999-0000"
STORE_WHATSAPP=5511999990000
STORE_CITY="São Paulo"
STORE_STATE=SP

# ---------------------------------------------------------------------------
# Créditos
# ---------------------------------------------------------------------------
DEVELOPER_NAME="Origin Hub"
DEVELOPER_URL=https://originhub.com.br

VITE_APP_NAME="${APP_NAME}"
